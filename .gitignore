/target
*.sqlite3
.roteiro/
website/dist/
# The OKF bundle is a build-output of the graph (`roteiro render okf`),
# regenerated locally and published as a CI artifact — never committed (it would
# be re-ingested by `sync`, and it churns on every code change). The directory is
# whatever `render okf` writes without `--out`, which
# `the_default_bundle_directory_is_ignored_here` holds this entry to.
/okf/

# macOS Finder metadata
.DS_Store

# Agent worktrees and local Claude Code state — never part of the repository.
.claude/
